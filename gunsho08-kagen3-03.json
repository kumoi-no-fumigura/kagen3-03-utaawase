 "poems": [
  {
   "seq": "1",
   "text": "猶もこのうきよの色そ捨かたき花のなさけのはるになれても",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "九重の池のみきはの花さかり馴しその世の春そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ちらぬまの花に詠むる春のとき幾夜もかくてあらはとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "よそになる身をは忘れて此春もむかしのまゝに花になれぬる",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春をしらん我身よいつは時しあれは四方の梢に花も咲きけり",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "よも山は霞のとけみをしてゆく春にかなへる花の色かな",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "うらめしくつれなの月やなき愁へ戀ひかこてとも同し影なる",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "見る月に哀のいかゝそはさらむ憂きにあらしとおもひなる頃",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "獨のみたゝ夜とともに月をみてかこつかたなきとをしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "こよひ我いかさまにしてなくさまむ月は哀に人は戀しき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "あさほらけ長閑きいろもこもりけり春の心や花にひらくる",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "春やさかり野山を見れはおしなへて梢は花のさかぬしもなし",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "おりをえて四方の櫻もさくなれは春は名たかき時にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花を惜み春をしたふととにかくに彌生はいつも物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "まつ人はむなしき床のひとりねに賴めぬ月の影のみそさす",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "またしとは思へとも猶月影のふくるをみれはまたそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あかなくのなかめの程にかへさはや花よりさきの春の日數を",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "なへて世の花てふ花は咲ぬらしはるも盛になりぬとおもへは",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "うき今の泪のうちになかむれは月も其夜にかけそかはれる",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "うれへ盡す心を月はしるらめは人にかたらぬ友とたのまむ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "わすられぬ月を哀とおもひいてゝ落る淚のやかてとまらぬ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "よな〓〓の月をかたみと思へとも見し世にかへる俤はなし",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "こぬ人をなとかすゝめぬ戀しさもつらさも誘ふ夜半の月かけ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "常よりも入はこゝろに戀しくて向ふこよひの月そかなしき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "うきてふる身のはかなさも悲しきはたゝめのまへの夕暮の雲",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "荒き雨は軒の檜はらにしたゝりて向ひの山も雲にかくれぬ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "かけつらく暮ぬと見つる大そらの雲のたへまにまた日影さす",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "山きよく雨ははれぬる夕くれのふもとの杉にくもそのこれる",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "見るまゝにほしの光もきよくなりて雲そ晴行曉のそら",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "むら雲に夕ひのかけは匂ひくれて向ひのやまの色そうつろふ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "はる〓〓といくへ雲路にへたつらむ忍ふこゝろにちかき都を",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "けふも又たゝ大そらの雲にのみわかなかめをはつくしぬる哉",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "夕暮のくもの行そらいつよりもさま〓〓ものを哀れとそみる",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "歸り見るたにゝ一むら雲をりてあらしにこゆる峯そはるけき",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "雲のゆくそなたの空をみやことてはかなくしたふ旅の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "山かけやゆふへの眺めしつかにて谷より雲ののほるをそ見る",
   "kana": "",
   "speaker": "",
   "page": 352,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
